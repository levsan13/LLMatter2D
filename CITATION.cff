    given-names: Sergio
    email: levy@fisica.ufc.br
    affiliation: Universidade Federal do Ceará
version: 0.1.0
date-released: 2026-10-28
license: MIT
repository-code: "https://github.com/levsan13/LLMatter2D"
keywords:
  - 2D materials
  - retrieval-augmented generation
  - large language models
  - DFT
  - ARPES
  - tight-binding
  - Archimedean lattices
